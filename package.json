{
  "name": "kan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/site",
    "packages/protocol",
    "packages/nodes",
    "apps/web",
    "apps/server",
    "apps/web-agent",
    "packages/web-core"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "npm run dev -w @kan/desktop",
    "build": "turbo run build",
    "preview": "npm run preview -w @kan/desktop",
    "tauri": "npm run tauri -w @kan/desktop --",
    "tauri:drive": "npm run tauri:drive -w @kan/desktop",
    "typecheck": "turbo run typecheck",
    "server": "tsx apps/server/src/main.ts",
    "test": "npm run test:backend && npm run test:desktop && npm run test:web",
    "test:backend": "npm run test -w @kan/server",
    "test:desktop": "tsx --tsconfig apps/desktop/tsconfig.json --test apps/desktop/test/*.test.ts apps/desktop/test/*.test.tsx",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:web": "npm run dev -w @kan/web",
    "test:web": "npm run test -w @kan/web-core",
    "build:web": "npm run build -w @kan/web",
    "typecheck:web": "npm run typecheck -w @kan/web",
    "dev:server": "npm run dev -w @kan/server",
    "dev:agent": "cd apps/web-agent && node --env-file-if-exists=../../.env.local ../../node_modules/eve/bin/eve.js dev",
    "typecheck:backend": "npm run typecheck -w @kan/server",
    "start:agent": "cd apps/web-agent && node --env-file-if-exists=../../.env.local ../../node_modules/eve/bin/eve.js build && node --env-file-if-exists=../../.env.local ../../node_modules/eve/bin/eve.js start"
  },
  "devDependencies": {
    "turbo": "^2.11.2",
    "typescript": "~6.0.3"
  }
}
