{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "../desktop/src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
