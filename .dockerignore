# The build context is the monorepo root, so keep it small. node_modules alone
# is 394M and would be re-sent to the daemon on every build.
node_modules
**/node_modules
.git
.turbo
**/.turbo
dist
**/dist

# The desktop shell is not in this image, but the server and web build import
# apps/desktop/src. src-tauri carries a Rust target/ dir that dwarfs everything.
apps/desktop/src-tauri
apps/desktop/public

# Never bake local secrets into an image layer.
.env
.env.*
!.env.example
**/.env.local

# Local SQLite lives on a volume, never in the image.
data
*.sqlite
*.sqlite-shm
*.sqlite-wal

*.log
.DS_Store
.vscode
.idea
**/.output
**/.eve

# Private QA reports and retired local experiments.
qa_bugs
spikes
**/.vercel
**/.nitro
**/.tanstack
