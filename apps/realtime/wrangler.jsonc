{
  "name": "kan-staging-realtime",
  "main": "src/worker.mjs",
  "account_id": "0a527d12d0e64c4642bb8de93dac757e",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "WEB_API_URL": "https://staging.getkan.dev/api/web" },
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "WebRoom" }] },
  "migrations": [{ "tag": "staging-v1", "new_sqlite_classes": ["StagingRoom"] }, { "tag": "web-v1", "new_sqlite_classes": ["WebRoom"] }],
  "r2_buckets": [{"binding":"ASSETS","bucket_name":"kan-staging-assets"}],
  "triggers": {"crons": ["* * * * *"]},
  "observability": { "enabled": false }
}
