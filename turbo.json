{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "TAURI_DEV_HOST"
  ],
  "globalPassThroughEnv": [
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/apps/desktop/src/**",
        "$TURBO_ROOT$/apps/desktop/tsconfig*.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/scripts/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/apps/desktop/src/**",
        "$TURBO_ROOT$/apps/desktop/tsconfig*.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/scripts/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/apps/desktop/src/**",
        "$TURBO_ROOT$/apps/desktop/tsconfig*.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "@kan/site#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/api/waitlist.js"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@kan/web-agent#build": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "WORKFLOW_POSTGRES_URL",
        "DATABASE_URL",
        "WORKFLOW_POSTGRES_*"
      ]
    }
  },
  "globalDependencies": [
    ".env",
    ".env.*",
    "packages/*/src/**"
  ]
}
