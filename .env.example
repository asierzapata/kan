# Copy to .env.local (`cp .env.example .env.local`). For `npm run dev:stack`
# (and `npm run stack:up`) AI_GATEWAY_API_KEY is needed only for AI turns.
# Local sign-up and canvas editing work with the defaults. Never overwrite an
# existing .env.local when pulling updates; compare names and add missing ones.
# Blank values count as unset.

# --- Shared by the server and the agent ---------------------------------------
# Bearer secret between apps/server and apps/web-agent, and for socket tickets.
KAN_SERVICE_SECRET=dev-service-secret

# --- apps/server (:8787) ------------------------------------------------------
# Signs Better Auth sessions (32+ characters). Replace outside local development.
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789
# Where the server reaches the agent.
EVE_URL=http://localhost:3100
# Defaults: embedded PGlite and local-disk assets under data/server (development only).
# KAN_ENV=development
# KAN_PUBLIC_URL=http://localhost:1430
# KAN_DATA_DIR=
# DATABASE_URL=
# KAN_RUN_CEILING=
# KAN_CONTEXT_RUN_CAP=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=

# --- apps/web-agent (:3100) ---------------------------------------------------
# Required for agent turns (Vercel AI Gateway).
AI_GATEWAY_API_KEY=
# Where the agent calls back into the server.
WEB_API_URL=http://localhost:8787/api/web
# Durable workflow state in Postgres instead of the local world.
# WORKFLOW_POSTGRES_URL=

# --- apps/web (Vite, :1430) and apps/desktop ----------------------------------
# VITE_TLDRAW_LICENSE_KEY=
VITE_MAPTILER_KEY=
VITE_BRANDFETCH_CLIENT_ID=

# --- apps/site ----------------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=
WAITLIST_WEBHOOK_SECRET=

# --- AI tooling (optional) ------------------------------------------------------
# Per-user Dokploy API key for scripts/dokploy-mcp.mjs (Dokploy → Settings → API Keys).
DOKPLOY_API_KEY=
# DOKPLOY_URL=https://dokploy.asierzapata.com
# Optional: limit panel requests (milliseconds), defaults 10000; retries default 1.
# DOKPLOY_TIMEOUT=10000
# DOKPLOY_RETRY_ATTEMPTS=1
# DOKPLOY_REDACT_ENV=true
# KAN_DOKPLOY_APP_NAME=kan-se2scu
