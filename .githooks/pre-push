#!/bin/sh
# The full pass, across every workspace: typecheck, tests, build.
#
# Escape hatch: `git push --no-verify`, or KAN_SKIP_HOOKS=1.

set -e

if [ -n "$KAN_SKIP_HOOKS" ]; then
  echo "pre-push: skipped (KAN_SKIP_HOOKS)"
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

failed=""

echo "pre-push: typecheck (all workspaces)"
npx turbo run typecheck --output-logs=errors-only || failed="$failed typecheck"

echo "pre-push: tests"
# `tsx --test` exits 0 when its glob matches nothing, which reads as a pass and
# is not one. Count the files so an empty suite is visible rather than green.
test_count=$(find apps/server/test -name '*.test.ts' 2>/dev/null | wc -l | tr -d ' ')
if [ "$test_count" = 0 ]; then
  echo "pre-push: WARNING — no server test files found, nothing to run"
fi
npx turbo run test --output-logs=errors-only || failed="$failed turbo-test"

echo "pre-push: build"
npx turbo run build --output-logs=errors-only || failed="$failed build"

if [ -n "$failed" ]; then
  echo
  echo "pre-push: failed:$failed"
  echo "  fix it, or push anyway with:  git push --no-verify"
  exit 1
fi

echo "pre-push: ok"
