{
  "name": "kan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/site",
    "apps/room-server",
    "apps/agent-runner",
    "packages/protocol",
    "packages/nodes",
    "apps/web",
    "apps/realtime",
    "apps/web-agent",
    "packages/web-core"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "npm run dev -w @kan/desktop",
    "build": "turbo run build",
    "preview": "npm run preview -w @kan/desktop",
    "tauri": "npm run tauri -w @kan/desktop --",
    "tauri:drive": "npm run tauri:drive -w @kan/desktop",
    "typecheck": "turbo run typecheck && npm run typecheck:backend",
    "server": "tsx apps/room-server/src/main.ts",
    "test": "npm run test:backend && npm run test:desktop && npm run test:web",
    "test:backend": "tsx --test apps/room-server/test/*.test.ts apps/agent-runner/test/*.test.ts",
    "test:desktop": "tsx --tsconfig apps/desktop/tsconfig.json --test apps/desktop/test/*.test.ts apps/desktop/test/*.test.tsx",
    "test:conversations": "tsx scripts/conversations.ts",
    "runner": "tsx apps/agent-runner/src/main.ts",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:web": "npm run dev -w @kan/web",
    "test:web": "npm run test -w @kan/web-core",
    "build:web": "npm run build -w @kan/web",
    "check:web-bundle": "node --no-experimental-require-module scripts/web/bundle-check.mjs",
    "typecheck:web": "npm run typecheck -w @kan/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tanstack/react-start": "1.168.60",
    "@types/pg": "8.23.1",
    "@workos/authkit-tanstack-react-start": "0.11.1",
    "eve": "0.71.0",
    "just-bash": "3.6.0",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.1",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.147.0"
  }
}
